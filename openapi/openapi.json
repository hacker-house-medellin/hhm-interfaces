{
  "openapi": "3.1.0",
  "info": {
    "title": "Hacker House Medellín API",
    "version": "0.1.0",
    "description": "Run rooms, desks, member stays, community events, access workflows, and day-to-day operations for a hacker house in Medellín, Colombia."
  },
  "servers": [
    {
      "url": "http://localhost:8080"
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "description": "service is alive"
          }
        }
      }
    },
    "/api/v1/reservations": {
      "get": {
        "operationId": "listReservations",
        "responses": {
          "200": {
            "description": "bounded list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Reservation"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createReservation",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateReservation"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Reservation"
                }
              }
            }
          },
          "422": {
            "description": "validation failure"
          }
        }
      }
    },
    "/api/v1/reservations/{id}": {
      "get": {
        "operationId": "getReservation",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Reservation"
                }
              }
            }
          },
          "404": {
            "description": "not found"
          }
        }
      }
    },
    "/v1/visitor-qr/{action}": {
      "post": {
        "operationId": "issueVisitorQr",
        "description": "Requires dual authentication and HHM product authorization for the verified provider, tenant, and subject tuple.",
        "security": [
          {
            "bearerAuth": []
          },
          {
            "supabaseToken": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "action",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "check-in",
                "check-out"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/visitor-access.json#/$defs/IssueQrRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "minute-bound QR payload issued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/visitor-access.json#/$defs/IssuedQr"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/VisitorError"
          },
          "403": {
            "$ref": "#/components/responses/VisitorError"
          },
          "422": {
            "$ref": "#/components/responses/VisitorError"
          },
          "503": {
            "$ref": "#/components/responses/VisitorError"
          }
        }
      }
    },
    "/v1/visits/check-in": {
      "post": {
        "operationId": "visitorCheckIn",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/visitor-access.json#/$defs/CheckInRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "visitor checked in; the private checkout receipt is returned once",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/visitor-access.json#/$defs/CheckInReceipt"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/VisitorError"
          },
          "422": {
            "$ref": "#/components/responses/VisitorError"
          },
          "429": {
            "$ref": "#/components/responses/VisitorError"
          },
          "503": {
            "$ref": "#/components/responses/VisitorError"
          }
        }
      }
    },
    "/v1/visits/check-out": {
      "post": {
        "operationId": "visitorCheckOut",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/visitor-access.json#/$defs/CheckOutRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "visitor checked out and the retained display name erased",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/visitor-access.json#/$defs/CheckOutReceipt"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/VisitorError"
          },
          "409": {
            "$ref": "#/components/responses/VisitorError"
          },
          "422": {
            "$ref": "#/components/responses/VisitorError"
          },
          "503": {
            "$ref": "#/components/responses/VisitorError"
          }
        }
      }
    },
    "/v1/presence/submission-nonces": {
      "post": {
        "operationId": "issuePresenceSubmissionNonce",
        "description": "Issues a short-lived, one-use nonce bound server-side to the verified principal, device policy, audience, and requested house. A nonce does not establish presence.",
        "security": [
          {
            "bearerAuth": []
          },
          {
            "supabaseToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/doorway-observation.json#/$defs/PresenceSubmissionNonceRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "short-lived presence submission nonce",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/doorway-observation.json#/$defs/PresenceSubmissionNonce"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/PresenceError"
          },
          "403": {
            "$ref": "#/components/responses/PresenceError"
          },
          "429": {
            "$ref": "#/components/responses/PresenceError"
          },
          "503": {
            "$ref": "#/components/responses/PresenceError"
          }
        }
      }
    },
    "/v1/presence/observations": {
      "post": {
        "operationId": "submitDoorwayObservation",
        "description": "Submits corroborated managed-doorway evidence from an enrolled device. Only an accepted backend decision advances presence; proximity alone never does.",
        "security": [
          {
            "bearerAuth": []
          },
          {
            "supabaseToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/doorway-observation.json#/$defs/DoorwayObservation"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "accepted or confirmation-required presence decision",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/doorway-observation.json#/$defs/PresenceDecision"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/PresenceError"
          },
          "403": {
            "$ref": "#/components/responses/PresenceError"
          },
          "409": {
            "$ref": "#/components/responses/PresenceError"
          },
          "422": {
            "$ref": "#/components/responses/PresenceError"
          },
          "429": {
            "$ref": "#/components/responses/PresenceError"
          },
          "503": {
            "$ref": "#/components/responses/PresenceError"
          }
        }
      }
    },
    "/ws": {
      "get": {
        "operationId": "websocket",
        "responses": {
          "101": {
            "description": "WebSocket upgrade"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      },
      "supabaseToken": {
        "type": "apiKey",
        "in": "header",
        "name": "x-supabase-token"
      }
    },
    "responses": {
      "VisitorError": {
        "description": "stable visitor-access error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/visitor-access.json#/$defs/ApiError"
            }
          }
        }
      },
      "PresenceError": {
        "description": "stable managed-presence error; availability failures remain distinct from invalid evidence",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/doorway-observation.json#/$defs/PresenceApiError"
            }
          }
        }
      }
    },
    "schemas": {
      "Reservation": {
        "$ref": "../schemas/reservation.json"
      },
      "CreateReservation": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "summary": {
            "type": "string",
            "maxLength": 4000
          }
        }
      },
      "VisitorIssueQrRequest": {
        "$ref": "../schemas/visitor-access.json#/$defs/IssueQrRequest"
      },
      "VisitorIssuedQr": {
        "$ref": "../schemas/visitor-access.json#/$defs/IssuedQr"
      },
      "VisitorCheckInRequest": {
        "$ref": "../schemas/visitor-access.json#/$defs/CheckInRequest"
      },
      "VisitorCheckInReceipt": {
        "$ref": "../schemas/visitor-access.json#/$defs/CheckInReceipt"
      },
      "VisitorCheckOutRequest": {
        "$ref": "../schemas/visitor-access.json#/$defs/CheckOutRequest"
      },
      "VisitorCheckOutReceipt": {
        "$ref": "../schemas/visitor-access.json#/$defs/CheckOutReceipt"
      },
      "PresenceSubmissionNonceRequest": {
        "$ref": "../schemas/doorway-observation.json#/$defs/PresenceSubmissionNonceRequest"
      },
      "PresenceSubmissionNonce": {
        "$ref": "../schemas/doorway-observation.json#/$defs/PresenceSubmissionNonce"
      },
      "DoorwayObservation": {
        "$ref": "../schemas/doorway-observation.json#/$defs/DoorwayObservation"
      },
      "PresenceDecision": {
        "$ref": "../schemas/doorway-observation.json#/$defs/PresenceDecision"
      }
    }
  }
}
