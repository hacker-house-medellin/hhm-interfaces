        "id",
        "tenantId",
        "reservationId",
        "issuedByAccountId",
        "guestReference",
        "status",
        "validFrom",
        "validUntil",
        "version",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "tenantId": {
          "type": "string",
          "maxLength": 128,
