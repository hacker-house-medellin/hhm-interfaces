        },
        "reservationId": {
          "type": "string",
          "format": "uuid",
          "x-ores-references": "Reservation.id"
        },
        "issuedByAccountId": {
          "type": "string",
          "format": "uuid",
          "x-ores-references": "Account.id"
        },
        "guestReference": { "type": "string", "maxLength": 128 },
        "guestDisplayName": { "type": "string", "maxLength": 160 },
