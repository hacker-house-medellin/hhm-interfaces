          "format": "uuid",
          "x-ores-references": "GuestPass.id"
        },
        "kind": { "$ref": "#/$defs/GuestPassTransitionKind" },
        "expectedVersion": { "type": "integer", "x-ores-width": 64 },
        "actorAccountId": {
          "type": "string",
          "format": "uuid",
          "x-ores-references": "Account.id"
        },
        "idempotencyKey": { "type": "string", "maxLength": 128 },
